{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Layan's Skate",
  "version": "0.23.0",
  "identifier": "com.convexstride.layansskate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Layan's Skate",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 360
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": []
  }
}
